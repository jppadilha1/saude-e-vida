/**
 * @fileoverview Firestore Security Rules for the academy application.
 *
 * Core Philosophy:
 * This ruleset prioritizes secure data access based on a combination of public read access for `students` and strict owner-only access for all other data. It leans towards strong authorization to prevent unauthorized data manipulation while relaxing schema validation for rapid prototyping.
 *
 * Data Structure:
 * - `/students/{studentId}`: Stores public information about each student, accessible to all.
 * - `/students/{studentId}/attendance/{attendanceId}`: Stores attendance records for each student, only accessible to the owner.
 *
 * Key Security Decisions:
 * - Public Read Access for `/students`: Allows any user to view the list of students.
 * - Owner-Only Access for `/students/{studentId}/attendance`: Enforces that only the owner can manage a student's attendance records.
 * - No User Listing: Listing all users is not permitted to prevent information disclosure.
 *
 * Denormalization for Authorization:
 * The security rules rely on the `studentId` in the path of the `attendance` collection to ensure that only the owner can access the data.
 * This avoids the need for complex queries to check ownership.
 *
 * Structural Segregation:
 * The app uses separate collections for public student data and private attendance records to simplify access control.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read the list of students. Only the owner can create, update, or delete student records.
     * @path /students/{studentId}
     * @allow (get, list): Anyone can read student data.
     * @allow (create): Only the owner can create a student record. The 'id' field must match the 'studentId' parameter.
     * @allow (update, delete): Only the owner can update or delete a student record.
     * @deny (create): If the 'id' field does not match the 'studentId' parameter.
     * @deny (update, delete): If the document does not exist.
     * @principle Provides public read access to student data, but restricts writes to the owner.
     */
    match /students/{studentId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.id == studentId;
      allow update: if isSignedIn() && isExistingOwner(studentId);
      allow delete: if isSignedIn() && isExistingOwner(studentId);
    }

    /**
     * @description Allows the owner to manage their own attendance records.
     * @path /students/{studentId}/attendance/{attendanceId}
     * @allow (create): The user must be signed in and the 'studentId' path segment must match the 'studentId' field in the document.
     * @allow (get, list, update, delete): The user must be signed in and the 'studentId' path segment must match the 'studentId' field in the document.
     * @deny (create): If the user is not signed in or the 'studentId' path segment does not match the 'studentId' field in the document.
     * @deny (get, list, update, delete): If the user is not signed in or the document does not exist.
     * @principle Enforces strict ownership for attendance records.
     */
    match /students/{studentId}/attendance/{attendanceId} {
      allow get: if isSignedIn() && isOwner(studentId);
      allow list: if isSignedIn() && isOwner(studentId);
      allow create: if isSignedIn() && request.resource.data.studentId == studentId;
      allow update: if isSignedIn() && isExistingOwner(studentId);
      allow delete: if isSignedIn() && isExistingOwner(studentId);
    }

    // --- Helper functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}