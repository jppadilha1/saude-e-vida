/**
 * @fileoverview Firestore Security Rules for the Academy App.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for student data,
 * ensuring that only authenticated users (teachers) can manage and view
 * student and attendance information. It also allows listing for authenticated users.
 *
 * Data Structure:
 * The data is structured hierarchically:
 * /students/{studentId} - Contains student profile information.
 * /students/{studentId}/attendance/{attendanceId} - Contains attendance records for each student.
 *
 * Key Security Decisions:
 * - Students collection is not public.
 * - Attendance subcollection are secured by student ID, preventing unauthorized access.
 *
 * Denormalization for Authorization:
 * - The rules rely on the `request.auth.uid` for ownership checks, which avoids costly `get()` calls.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secures the /students collection.
     * @path /students/{studentId}
     * @allow (create, update, delete) Authenticated user can manage students.
     * @allow (get, list) Authenticated users can list students.
     * @deny (create, update, delete) Unauthenticated users cannot manage students.
     * @principle Enforces authenticated user access.
     */
    match /students/{studentId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Secures the /students/{studentId}/attendance subcollection.
     * @path /students/{studentId}/attendance/{attendanceId}
     * @allow (create, update, delete) Authenticated users can manage attendance records for students.
     * @allow (get, list) Authenticated users can list attendance records for students.
     * @deny (create, update, delete) Unauthenticated users cannot manage attendance records.
     * @principle Enforces authenticated user access on nested resources.
     */
    match /students/{studentId}/attendance/{attendanceId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    function isSignedIn() {
      return request.auth != null;
    }
  }
}