/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for student data and attendance records.
 *
 * Data Structure:
 * - /students/{studentId}: Stores student profile information.
 * - /students/{studentId}/attendance/{attendanceId}: Stores individual attendance records for each student.
 *
 * Key Security Decisions:
 * - Students can only read their own attendance records.
 * - Students cannot be listed.
 * - All write operations (create, update, delete) are explicitly denied unless authorized.
 *
 * Denormalization for Authorization:
 * - The 'Attendance' entity includes a 'studentId' field, which is validated against the path to enforce ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Prevents listing all students.
     * @path /students
     * @allow (get) Any authenticated user can get a student document.
     * @deny (list) No one can list all students.
     * @principle Prevents unauthorized access to student profiles.
     */
    match /students {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages student profile access.
     * @path /students/{studentId}
     * @allow (create) A user can create their own student profile if the studentId matches their UID.
     * @allow (get) Any authenticated user can get a student document.
     * @deny (create) A user cannot create a student profile with an ID that doesn't match their UID.
     * @deny (update) A user cannot update a student profile that doesn't belong to them.
     * @deny (delete) A user cannot delete a student profile that doesn't belong to them.
     * @principle Enforces document ownership for writes.
     */
    match /students/{studentId} {
      allow get: if isSignedIn();
      allow create: if isOwner(studentId) && request.resource.data.id == studentId;
      allow update: if isExistingOwner(studentId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(studentId);
      allow list: if false;
    }

    /**
     * @description Manages student attendance records.
     * @path /students/{studentId}/attendance/{attendanceId}
     * @allow (list) A student can list their own attendance records.
     * @allow (create) Only a student can create attendance records for themselves, and studentId must match the parent path.
     * @allow (get) A student can get their own attendance records
     * @deny (create) A student cannot create attendance records for another student.
     * @deny (update) A student cannot update attendance records that don't belong to them.
     * @deny (delete) A student cannot delete attendance records that don't belong to them.
     * @principle Enforces document ownership for writes.
     */
    match /students/{studentId}/attendance/{attendanceId} {
      allow get: if isSignedIn() && isOwner(studentId);
      allow list: if isSignedIn() && isOwner(studentId);
      allow create: if isOwner(studentId) && request.resource.data.studentId == studentId;
      allow update: if isExistingOwnerForAttendance(studentId, resource.data.studentId);
      allow delete: if isExistingOwnerForAttendance(studentId, resource.data.studentId);
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

     function isExistingOwnerForAttendance(studentId, attendanceStudentId) {
        return isSignedIn() && resource != null && isOwner(studentId) && studentId == attendanceStudentId;
    }
  }
}