/**
 * @description This ruleset enforces a strict user-ownership model for student data, attendance records, and payment history.
 * All data is nested under /students/{studentId}, ensuring data isolation between students.
 * Only authenticated users can access data.
 *
 * Key Security Decisions:
 * - Students collection: Public read access is enabled. Only authenticated users can create/update/delete, requiring the 'id' field to match their UID for authorization.
 * - Attendance and Payments: Only the owner of a student document can manage its attendance and payment records.
 * - Listing is only allowed for owners of student documents.
 *
 * Denormalization for Authorization:
 * - The studentId is used for authorization checks on attendance and payment records.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to student data, but restricts write access to authenticated users who own the student document.
     * @path /students/{studentId}
     * @allow (get, list)
     * @allow (create) request.auth != null && request.resource.data.id == request.auth.uid
     * @allow (update, delete) request.auth != null && resource.data.id == request.auth.uid && resource != null
     * @deny (create) request.auth == null
     * @deny (update, delete) request.auth == null || resource.data.id != request.auth.uid || resource == null
     * @principle Allows public read access with owner-only writes, enforcing document ownership for writes.
     */
    match /students/{studentId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.id == request.auth.uid;
      allow update, delete: if isExistingOwner(studentId);
    }

    /**
     * @description Restricts access to attendance records to the owner of the student document.
     * @path /students/{studentId}/attendance/{attendanceId}
     * @allow (get, list) request.auth != null && isOwner(studentId)
     * @allow (create) request.auth != null && isOwner(studentId)
     * @allow (update, delete) request.auth != null && isOwner(studentId) && resource != null
     * @deny (get, list) request.auth == null || !isOwner(studentId)
     * @deny (create) request.auth == null || !isOwner(studentId)
     * @deny (update, delete) request.auth == null || !isOwner(studentId) || resource == null
     * @principle Restricts access to a user's own data tree.
     */
    match /students/{studentId}/attendance/{attendanceId} {
      allow get, list: if isSignedIn() && isOwner(studentId);
      allow create: if isSignedIn() && isOwner(studentId);
      allow update, delete: if isSignedIn() && isExistingOwner(studentId);
    }

    /**
     * @description Restricts access to payment records to the owner of the student document.
     * @path /students/{studentId}/payments/{paymentId}
     * @allow (get, list) request.auth != null && isOwner(studentId)
     * @allow (create) request.auth != null && isOwner(studentId)
     * @allow (update, delete) request.auth != null && isOwner(studentId) && resource != null
     * @deny (get, list) request.auth == null || !isOwner(studentId)
     * @deny (create) request.auth == null || !isOwner(studentId)
     * @deny (update, delete) request.auth == null || !isOwner(studentId) || resource == null
     * @principle Restricts access to a user's own data tree.
     */
    match /students/{studentId}/payments/{paymentId} {
      allow get, list: if isSignedIn() && isOwner(studentId);
      allow create: if isSignedIn() && isOwner(studentId);
      allow update, delete: if isSignedIn() && isExistingOwner(studentId);
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(studentId) {
        return request.auth.uid == studentId;
    }

    function isExistingOwner(studentId) {
      return isOwner(studentId) && resource != null;
    }
  }
}