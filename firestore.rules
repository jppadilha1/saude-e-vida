/**
 * @fileoverview Firestore Security Rules for Prototyping.
 *
 * Core Philosophy:
 * This ruleset prioritizes rapid prototyping by focusing on authorization and relationship integrity,
 * while minimizing data-shape validation to allow for flexible schema evolution.  It enforces
 * strict owner-only access to data, with public read access where appropriate.
 *
 * Data Structure:
 * - /students/{studentId}: Stores student profile data.  studentId is the Firebase auth UID.
 * - /students/{studentId}/attendance/{attendanceId}: Stores attendance records for a student.
 *
 * Key Security Decisions:
 * - Listing of all students is denied to all users to protect privacy.
 * - Only the authenticated user who owns a student profile can create, update, or delete it.
 * - Attendance records inherit the ownership of the parent student document.
 *
 * Denormalization for Authorization:
 * The `studentId` is automatically enforced to match the authenticated user's UID on creation to simplify authorization checks.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces access control for student profiles.
     * @path /students/{studentId}
     * @allow (create) Authenticated user can create their own student profile, with matching studentId.
     * @allow (get, update, delete) Authenticated user can read, update, and delete their own student profile.
     * @deny (list) Listing all students is not allowed.
     * @deny (create) Authenticated user cannot create a student profile with a mismatched studentId.
     * @deny (update, delete) Authenticated user cannot update or delete another user's student profile.
     * @principle Enforces document ownership for writes.
     */
    match /students/{studentId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(studentId) {
        return request.auth.uid == studentId;
      }

      function isExistingOwner(studentId) {
        return isOwner(studentId) && resource != null;
      }

      // Read rules
      allow get: if isOwner(studentId);
      allow list: if false;

      // Write rules
      allow create: if isSignedIn() && isOwner(studentId) && request.resource.data.id == studentId;
      allow update: if isExistingOwner(studentId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(studentId);
    }

    /**
     * @description Enforces access control for attendance records of a specific student.
     * @path /students/{studentId}/attendance/{attendanceId}
     * @allow (create) Authenticated user (owner of the student profile) can create attendance records for their student profile.
     * @allow (get, update, delete) Authenticated user (owner of the student profile) can read, update, and delete attendance records for their student profile.
     * @deny (list) Listing attendance records is allowed only for the student's owner.
     * @deny (create, update, delete) Authenticated user cannot create, update, or delete attendance records for another user's student profile.
     * @principle Enforces document ownership and relational integrity.
     */
    match /students/{studentId}/attendance/{attendanceId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(studentId) {
        return request.auth.uid == studentId;
      }

      function isExistingOwner(studentId) {
        return isOwner(studentId) && resource != null;
      }

      // Read rules
      allow get: if isOwner(studentId);
      allow list: if isOwner(studentId);

      // Write rules
      allow create: if isSignedIn() && isOwner(studentId);
      allow update: if isExistingOwner(studentId);
      allow delete: if isExistingOwner(studentId);
    }
  }
}