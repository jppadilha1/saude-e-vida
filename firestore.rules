/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for student data,
 * attendance records, and payment history. Only the authenticated user who "owns"
 * a particular student document can read or write to it and its subcollections.
 *
 * Data Structure:
 * - /students/{studentId}: Stores student profiles.  The {studentId} MUST match the
 *   authenticated user's UID for ownership to be established.
 * - /students/{studentId}/attendance/{attendanceId}: Stores attendance records for a student.
 *   Inherits ownership from the parent student document.
 * - /students/{studentId}/payments/{paymentId}: Stores payment records for a student.
 *   Inherits ownership from the parent student document.
 *
 * Key Security Decisions:
 * - User data is private and only accessible to the owning user.
 * - Listing of all students is disallowed to prevent information leakage.
 * - Data consistency between the path and the document's internal fields is enforced
 *   on creation and updates to prevent unauthorized data manipulation.
 *
 * Denormalization for Authorization:
 *  - The `studentId` is used in the path `/students/{studentId}` and is implicitly
 *    the owner. This is validated against `request.auth.uid` for authorization.
 *
 * Structural Segregation:
 *  - Private student data is stored under the `/students/{studentId}` path, ensuring
 *    that only the owning user can access it.  There is no public data in this model.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secures the student profiles collection, ensuring only the owner can read and write.
     * @path /students/{studentId}
     * @allow (create) - Authenticated user with UID 'user123' can create a student document with ID 'user123'.
     * @allow (get, update, delete) - Authenticated user with UID 'user123' can access/modify a student document with ID 'user123'.
     * @deny (create) - Authenticated user with UID 'user456' cannot create a student document with ID 'user123'.
     * @deny (get, update, delete) - Authenticated user with UID 'user456' cannot access/modify a student document with ID 'user123'.
     * @principle Enforces document ownership for all operations.
     */
    match /students/{studentId} {
      // Check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      // Check if the requested user id is the same as the currently authenticated user id.
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Check if the user is the owner and the document exists
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(studentId);
      allow list: if false; // Listing all students is not permitted.
      allow create: if isSignedIn() && isOwner(studentId) && request.resource.data.id == studentId;
      allow update: if isExistingOwner(studentId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(studentId);
    }

    /**
     * @description Secures the attendance records subcollection, ensuring only the owner of the student document can read and write.
     * @path /students/{studentId}/attendance/{attendanceId}
     * @allow (create) - Authenticated user with UID 'user123' can create an attendance document under student 'user123'.
     * @allow (get, list, update, delete) - Authenticated user with UID 'user123' can access/modify attendance documents under student 'user123'.
     * @deny (create) - Authenticated user with UID 'user456' cannot create an attendance document under student 'user123'.
     * @deny (get, list, update, delete) - Authenticated user with UID 'user456' cannot access/modify attendance documents under student 'user123'.
     * @principle Enforces document ownership for all operations.
     */
    match /students/{studentId}/attendance/{attendanceId} {
      // Check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      // Check if the requested user id is the same as the currently authenticated user id.
      function isOwner(studentId) {
        return request.auth.uid == studentId;
      }

      // Check if the user is the owner and the document exists
      function isExistingOwner(studentId) {
        return isOwner(studentId) && resource != null;
      }
      allow get: if isOwner(studentId);
      allow list: if isOwner(studentId);
      allow create: if isSignedIn() && isOwner(studentId);
      allow update: if isExistingOwner(studentId);
      allow delete: if isExistingOwner(studentId);
    }

    /**
     * @description Secures the payments subcollection, ensuring only the owner of the student document can read and write.
     * @path /students/{studentId}/payments/{paymentId}
     * @allow (create) - Authenticated user with UID 'user123' can create a payment document under student 'user123'.
     * @allow (get, list, update, delete) - Authenticated user with UID 'user123' can access/modify payment documents under student 'user123'.
     * @deny (create) - Authenticated user with UID 'user456' cannot create a payment document under student 'user123'.
     * @deny (get, list, update, delete) - Authenticated user with UID 'user456' cannot access/modify payment documents under student 'user123'.
     * @principle Enforces document ownership for all operations.
     */
    match /students/{studentId}/payments/{paymentId} {
      // Check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      // Check if the requested user id is the same as the currently authenticated user id.
      function isOwner(studentId) {
        return request.auth.uid == studentId;
      }

      // Check if the user is the owner and the document exists
      function isExistingOwner(studentId) {
        return isOwner(studentId) && resource != null;
      }
      allow get: if isOwner(studentId);
      allow list: if isOwner(studentId);
      allow create: if isSignedIn() && isOwner(studentId);
      allow update: if isExistingOwner(studentId);
      allow delete: if isExistingOwner(studentId);
    }
  }
}