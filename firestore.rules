/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for student data and attendance records.
 *
 * Data Structure:
 * - /students/{studentId}: Stores student profile information.
 * - /students/{studentId}/attendance/{attendanceId}: Stores attendance records for each student.
 *
 * Key Security Decisions:
 * - Students collection requires authentication for all operations.
 * - Students collection is publicly readable.
 * - Subcollections are only accessible by the owner of the parent document.
 *
 * Denormalization for Authorization:
 * - The `attendance` documents contains a `studentId` field, which must match the parent document ID to validate the relationship.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to the students collection.
     * @path /students/{studentId}
     * @allow (get, list): Any user can read student profiles.
     * @allow (create): Only an authenticated user can create a student profile, and the studentId must match the authenticated user's ID.
     * @allow (update, delete): Only the owner (same studentId) can update or delete their profile.
     * @deny (create): Non-authenticated users cannot create student profiles.
     * @deny (update, delete): Other authenticated users cannot modify or delete another user's student profile.
     * @principle Enforces document ownership for writes, and public reads.
     */
    match /students/{studentId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.id == request.auth.uid;
      allow update: if isExistingOwner(studentId);
      allow delete: if isExistingOwner(studentId);
    }

    /**
     * @description Controls access to the attendance subcollection for each student.
     * @path /students/{studentId}/attendance/{attendanceId}
     * @allow (get, list): Only the owner (same studentId) can read their own attendance records.
     * @allow (create): Only the owner (same studentId) can create new attendance records. The studentId field in the attendance document must match the parent studentId.
     * @allow (update, delete): Only the owner (same studentId) can update or delete their attendance records.
     * @deny (create): Creating attendance records with mismatched studentId is denied.
     * @deny (update, delete): Other authenticated users cannot modify or delete another user's attendance records.
     * @principle Enforces document ownership and relational integrity for writes.
     */
    match /students/{studentId}/attendance/{attendanceId} {
      allow get, list: if isOwner(studentId);
      allow create: if isOwner(studentId) && request.resource.data.studentId == studentId;
      allow update: if isExistingAttendanceOwner(studentId, attendanceId) && request.resource.data.studentId == resource.data.studentId;
      allow delete: if isExistingAttendanceOwner(studentId, attendanceId);
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    function isExistingAttendanceOwner(studentId, attendanceId) {
        return isOwner(studentId) && exists(/databases/$(database)/documents/students/$(studentId)/attendance/$(attendanceId));
    }
  }
}