/**
 * @fileOverview Firestore Security Rules for the academy app.
 *
 * Core Philosophy:
 * This ruleset implements a strict user-ownership model for student data. Only authenticated users can access student records and their associated attendance and payment information.
 *
 * Data Structure:
 * - /students/{studentId}: Stores student profile data.
 * - /students/{studentId}/attendance/{attendanceId}: Stores individual attendance records for a student.
 * - /students/{studentId}/payments/{paymentId}: Stores payment records for a student.
 *
 * Key Security Decisions:
 * - Listing of the /students collection is disallowed to prevent unauthorized data enumeration.
 * - All write operations require an authenticated user.
 * - Data consistency between document IDs and path segments is enforced to maintain relational integrity.
 *
 * Denormalization for Authorization:
 *  The `studentId` is used within subcollections (`attendance`, `payments`) to enforce ownership and avoid `get()` calls.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces access control for the /students collection.
     * @path /students/{studentId}
     * @allow (create) Authenticated user creates a student profile where the studentId matches their own user ID.
     * @deny (create) User attempts to create a student profile with a mismatched studentId.
     * @allow (get) Authenticated user retrieves their own student profile.
     * @deny (get) Unauthenticated user attempts to retrieve a student profile.
     * @allow (list) Listing of all students is not permitted.
     * @deny (list) Any attempt to list the /students collection.
     * @allow (update) Authenticated user updates their own student profile.
     * @deny (update) User attempts to update a student profile they do not own.
     * @allow (delete) Authenticated user deletes their own student profile.
     * @deny (delete) User attempts to delete a student profile they do not own.
     * @principle Enforces document ownership for writes, restricts listing of user data, and validates ownership on creation.
     */
    match /students/{studentId} {
      allow get: if isSignedIn() && isOwner(studentId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(studentId) && request.resource.data.id == studentId;
      allow update: if isSignedIn() && isExistingOwner(studentId) && request.resource.data.id == resource.data.id;
      allow delete: if isSignedIn() && isExistingOwner(studentId);
    }

    /**
     * @description Enforces access control for the /students/{studentId}/attendance collection.
     * @path /students/{studentId}/attendance/{attendanceId}
     * @allow (create) Authenticated user creates an attendance record for their own student profile.
     * @deny (create) User attempts to create an attendance record for a student profile they do not own.
     * @allow (get) Authenticated user retrieves an attendance record for their own student profile.
     * @deny (get) Unauthenticated user attempts to retrieve an attendance record.
     * @allow (list) Authenticated user lists attendance records for their own student profile.
     * @deny (list) User attempts to list attendance records for a student profile they do not own.
     * @allow (update) Authenticated user updates an attendance record for their own student profile.
     * @deny (update) User attempts to update an attendance record they do not own.
     * @allow (delete) Authenticated user deletes an attendance record for their own student profile.
     * @deny (delete) User attempts to delete an attendance record they do not own.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree, and validates relational integrity between documents.
     */
    match /students/{studentId}/attendance/{attendanceId} {
      allow get: if isSignedIn() && isOwner(studentId);
      allow list: if isSignedIn() && isOwner(studentId);
      allow create: if isSignedIn() && isOwner(studentId) && request.resource.data.studentId == studentId;
      allow update: if isSignedIn() && isExistingOwner(studentId) && resource.data.studentId == studentId;
      allow delete: if isSignedIn() && isExistingOwner(studentId) && resource.data.studentId == studentId;
    }

    /**
     * @description Enforces access control for the /students/{studentId}/payments collection.
     * @path /students/{studentId}/payments/{paymentId}
     * @allow (create) Authenticated user creates a payment record for their own student profile.
     * @deny (create) User attempts to create a payment record for a student profile they do not own.
     * @allow (get) Authenticated user retrieves a payment record for their own student profile.
     * @deny (get) Unauthenticated user attempts to retrieve a payment record.
     * @allow (list) Authenticated user lists payment records for their own student profile.
     * @deny (list) User attempts to list payment records for a student profile they do not own.
     * @allow (update) Authenticated user updates a payment record for their own student profile.
     * @deny (update) User attempts to update a payment record they do not own.
     * @allow (delete) Authenticated user deletes a payment record for their own student profile.
     * @deny (delete) User attempts to delete a payment record they do not own.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree, and validates relational integrity between documents.
     */
    match /students/{studentId}/payments/{paymentId} {
      allow get: if isSignedIn() && isOwner(studentId);
      allow list: if isSignedIn() && isOwner(studentId);
      allow create: if isSignedIn() && isOwner(studentId) && request.resource.data.studentId == studentId;
      allow update: if isSignedIn() && isExistingOwner(studentId) && resource.data.studentId == studentId;
      allow delete: if isSignedIn() && isExistingOwner(studentId) && resource.data.studentId == studentId;
    }
  }

  // Helper function to determine if the user is signed in.
  function isSignedIn() {
    return request.auth != null;
  }

  // Helper function to determine if the user is the owner of the document.
  function isOwner(userId) {
    return request.auth.uid == userId;
  }

    // Helper function to determine if the user is the owner of the document AND it exists.
  function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }
}