/**
 * @file Firestore Security Rules
 * @version 2
 *
 * @Core Philosophy
 * This ruleset enforces a strict user-ownership model for student data. Each student's document
 * and their associated attendance records are only accessible to the student themselves.
 *
 * @Data Structure
 * Data is organized hierarchically under the `/students/{studentId}` path, with attendance
 * records stored in the `/students/{studentId}/attendance/{attendanceId}` subcollection.
 *
 * @Key Security Decisions
 * - Students can only access their own data and attendance records.
 * - Listing all students is disallowed to prevent unauthorized access to potentially sensitive information.
 *
 * @Denormalization for Authorization
 * The `Attendance` documents contain `studentId` which will be validated against the parent path.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to student documents.
     * @path /students/{studentId}
     * @allow (create) User with UID 'student_abc' can create their own student document.
     * @allow (get) User with UID 'student_abc' can get their own student document.
     * @allow (update) User with UID 'student_abc' can update their own student document.
     * @allow (delete) User with UID 'student_abc' can delete their own student document.
     * @deny (create) User with UID 'another_user' cannot create a student document with ID 'student_abc'.
     * @deny (get) User with UID 'another_user' cannot get the student document with ID 'student_abc'.
     * @principle Enforces document ownership for all operations on the student document.
     */
    match /students/{studentId} {
      // Verify identity
      function isSignedIn() {
        return request.auth != null;
      }

      // Verify ownership
      function isOwner(studentId) {
        return request.auth.uid == studentId;
      }

      //Verify existing ownership
      function isExistingOwner(studentId) {
        return isOwner(studentId) && resource != null;
      }

      // Allow a user to read their own student document
      allow get: if isOwner(studentId);

      // Prevent listing all student documents
      allow list: if false;

      // Allow a user to create their own student document if the studentId matches their UID
      allow create: if isSignedIn() && request.auth.uid == studentId;

      // Allow a user to update their own student document
      allow update: if isExistingOwner(studentId);

      // Allow a user to delete their own student document
      allow delete: if isExistingOwner(studentId);

    
      match /attendance/{attendanceId} {
        // Verify identity
        function isSignedIn() {
          return request.auth != null;
        }

        // Verify ownership based on the parent studentId
        function isOwner(studentId) {
          return request.auth.uid == studentId;
        }

        //Verify existing ownership
        function isExistingOwner(studentId) {
          return isOwner(studentId) && resource != null;
        }
       
        function parent_studentId() {
          return string(path.split('/')[2]);
        }

        // Allow a user to read their own attendance records
        allow get: if isOwner(studentId);

        // Allow a user to list their own attendance records
        allow list: if isOwner(studentId);

        // Allow a user to create an attendance record for themselves if the studentId matches the parent and the document.
        allow create: if isSignedIn() && request.auth.uid == studentId;

        // Allow a user to update their own attendance record, and ensure the studentId cannot be changed
        allow update: if isExistingOwner(studentId);

        // Allow a user to delete their own attendance record
        allow delete: if isExistingOwner(studentId);
        
      }
    }
  }
}