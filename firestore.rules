/**
 * @file Firestore Security Rules
 * @version 2
 *
 * @description
 * This ruleset enforces a strict user-ownership model for student data, attendance records, and payment history.
 * Only authenticated users can access data, and they can only access data associated with their own student ID.
 *
 * @dataStructure
 * - /students/{studentId}: Stores student profile information.
 * - /students/{studentId}/attendance/{attendanceId}: Stores attendance records for a specific student.
 * - /students/{studentId}/payments/{paymentId}: Stores payment history for a specific student.
 *
 * @keySecurityDecisions
 * - Students collection is not publicly listable
 * - All write operations are restricted to authenticated users with matching student IDs.
 *
 * @denormalizationForAuthorization
 * - The 'studentId' is used in the path for both 'attendance' and 'payments' collections, ensuring authorization can be performed without additional reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects the /students collection. Only authenticated users can read or write data, and only if the `studentId` matches their `auth.uid`.
     * @path /students/{studentId}
     * @allow (get) An authenticated user can read a student document if the `studentId` matches their `auth.uid`.
     * @allow (create) An authenticated user can create a student document if the `studentId` matches their `auth.uid`.
     * @allow (update) An authenticated user can update a student document if the `studentId` matches their `auth.uid` and the document exists.
     * @allow (delete) An authenticated user can delete a student document if the `studentId` matches their `auth.uid` and the document exists.
     * @deny (get) An unauthenticated user cannot read a student document.
     * @deny (create) An unauthenticated user cannot create a student document.
     * @deny (update) An unauthenticated user cannot update a student document.
     * @deny (delete) An unauthenticated user cannot delete a student document.
     * @principle Enforces document ownership based on the `studentId` and `auth.uid`.
     */
    match /students/{studentId} {
      allow get: if isSignedIn() && isOwner(studentId);
      allow list: if false; // Students collection is not publicly listable
      allow create: if isSignedIn() && isOwner(studentId) && request.resource.data.id == studentId;
      allow update: if isSignedIn() && isExistingOwner(studentId) && request.resource.data.id == resource.data.id;
      allow delete: if isSignedIn() && isExistingOwner(studentId);
    }

    /**
     * @description Protects the /students/{studentId}/attendance collection. Only authenticated users can read or write data, and only if the `studentId` matches their `auth.uid`.
     * @path /students/{studentId}/attendance/{attendanceId}
     * @allow (get) An authenticated user can read an attendance document if the `studentId` matches their `auth.uid`.
     * @allow (create) An authenticated user can create an attendance document if the `studentId` matches their `auth.uid`.
     * @allow (update) An authenticated user can update an attendance document if the `studentId` matches their `auth.uid` and the document exists.
     * @allow (delete) An authenticated user can delete an attendance document if the `studentId` matches their `auth.uid` and the document exists.
     * @deny (get) An unauthenticated user cannot read an attendance document.
     * @deny (create) An unauthenticated user cannot create an attendance document.
     * @deny (update) An unauthenticated user cannot update an attendance document.
     * @deny (delete) An unauthenticated user cannot delete an attendance document.
     * @principle Enforces document ownership based on the `studentId` and `auth.uid`.
     */
    match /students/{studentId}/attendance/{attendanceId} {
      allow get: if isSignedIn() && isOwner(studentId);
      allow list: if isSignedIn() && isOwner(studentId);
      allow create: if isSignedIn() && isOwner(studentId) ;
      allow update: if isSignedIn() && isExistingOwner(studentId);
      allow delete: if isSignedIn() && isExistingOwner(studentId);
    }

    /**
     * @description Protects the /students/{studentId}/payments collection. Only authenticated users can read or write data, and only if the `studentId` matches their `auth.uid`.
     * @path /students/{studentId}/payments/{paymentId}
     * @allow (get) An authenticated user can read a payment document if the `studentId` matches their `auth.uid`.
     * @allow (create) An authenticated user can create a payment document if the `studentId` matches their `auth.uid`.
     * @allow (update) An authenticated user can update a payment document if the `studentId` matches their `auth.uid` and the document exists.
     * @allow (delete) An authenticated user can delete a payment document if the `studentId` matches their `auth.uid` and the document exists.
     * @deny (get) An unauthenticated user cannot read a payment document.
     * @deny (create) An unauthenticated user cannot create a payment document.
     * @deny (update) An unauthenticated user cannot update a payment document.
     * @deny (delete) An unauthenticated user cannot delete a payment document.
     * @principle Enforces document ownership based on the `studentId` and `auth.uid`.
     */
    match /students/{studentId}/payments/{paymentId} {
      allow get: if isSignedIn() && isOwner(studentId);
      allow list: if isSignedIn() && isOwner(studentId);
      allow create: if isSignedIn() && isOwner(studentId);
      allow update: if isSignedIn() && isExistingOwner(studentId);
      allow delete: if isSignedIn() && isExistingOwner(studentId);
    }
  }

  // Helper Functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }
}