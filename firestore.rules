/**
 * @description This ruleset enforces a strict user-ownership model for student and attendance data.
 * All data is stored under the top-level collections `/students/{studentId}` and
 * `/students/{studentId}/attendance/{attendanceId}`.
 *
 * Data Structure:
 * - /students/{studentId}: Stores student profile information. The `studentId` is used as the document ID.
 * - /students/{studentId}/attendance/{attendanceId}: Stores attendance records for a specific student.
 *   The `attendanceId` is used as the document ID.
 *
 * Key Security Decisions:
 * - Students collection and subcollections are only readable by authenticated users (no public access).
 * - Students can only create, update, or delete their own documents.
 * - Listing of the students collection is explicitly denied.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to the /students collection.
     * @path /students/{studentId}
     * @allow (create) Authenticated user can create a student document if the studentId matches their UID.
     * @allow (get) Authenticated user can get a student document if the studentId matches their UID.
     * @allow (update) Authenticated user can update a student document if the studentId matches their UID and the document exists.
     * @allow (delete) Authenticated user can delete a student document if the studentId matches their UID and the document exists.
     * @deny (list) Listing all students is not allowed.
     * @deny (create) Unauthenticated users cannot create student documents.
     * @deny (update) Authenticated user cannot update other student's documents.
     * @deny (delete) Authenticated user cannot delete other student's documents.
     * @principle Enforces document ownership for writes.
     */
    match /students/{studentId} {
      allow get: if isSignedIn() && isOwner(studentId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(studentId) && request.resource.data.id == studentId;
      allow update: if isSignedIn() && isExistingOwner(studentId) && request.resource.data.id == resource.data.id;
      allow delete: if isSignedIn() && isExistingOwner(studentId);
    }

    /**
     * @description Controls access to the /students/{studentId}/attendance/{attendanceId} collection.
     * @path /students/{studentId}/attendance/{attendanceId}
     * @allow (create) Authenticated user can create an attendance document for their student if the studentId matches their UID.
     * @allow (get) Authenticated user can get an attendance document for their student if the studentId matches their UID.
     * @allow (update) Authenticated user can update an attendance document for their student if the studentId matches their UID and the document exists.
     * @allow (delete) Authenticated user can delete an attendance document for their student if the studentId matches their UID and the document exists.
     * @deny (list) Listing all attendance records is not allowed.
     * @deny (create) Unauthenticated users cannot create attendance documents.
     * @deny (update) Authenticated user cannot update other student's attendance documents.
     * @deny (delete) Authenticated user cannot delete other student's attendance documents.
     * @principle Enforces document ownership for writes.
     */
    match /students/{studentId}/attendance/{attendanceId} {
      allow get: if isSignedIn() && isOwner(studentId);
      allow list: if isSignedIn() && isOwner(studentId);
      allow create: if isSignedIn() && isOwner(studentId) && request.resource.data.studentId == studentId;
      allow update: if isSignedIn() && isExistingOwner(studentId) && resource.data.studentId == studentId;
      allow delete: if isSignedIn() && isExistingOwner(studentId) && resource.data.studentId == studentId;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}