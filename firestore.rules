/**
 * @fileoverview Firestore Security Rules for the academy application.
 *
 * Core Philosophy:
 * This ruleset implements an administrator-only access model. Only the user with the specified UID ('9LEIXoYmuzda2PrdFzhfPrv4pE93') has full read and write access to all data.
 *
 * Data Structure:
 * Data is organized under the following collections:
 * - /students/{studentId}: Stores student data.
 * - /students/{studentId}/attendance/{attendanceId}: Stores attendance records for each student.
 * - /students/{studentId}/payments/{paymentId}: Stores payment history for each student.
 *
 * Key Security Decisions:
 * - Administrator-Only Access: Only a specific user (defined by ADMIN_UID) is granted full access. All other users are denied access.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Define the administrator's UID
    function isAdmin() {
      return request.auth.uid == '9LEIXoYmuzda2PrdFzhfPrv4pE93';
    }

    function isSignedIn() {
        return request.auth != null;
    }

    /**
     * @description Controls access to the /students collection.
     * @path /students/{studentId}
     * @allow (create, update, delete) if the user is the administrator.
     * @allow (get, list) if the user is the administrator.
     * @deny (create, update, delete) if the user is not the administrator.
     * @deny (get, list) if the user is not the administrator.
     * @principle Enforces administrator-only access to student data.
     */
    match /students/{studentId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    /**
     * @description Controls access to the /students/{studentId}/attendance collection.
     * @path /students/{studentId}/attendance/{attendanceId}
     * @allow (create, update, delete) if the user is the administrator.
     * @allow (get, list) if the user is the administrator.
     * @deny (create, update, delete) if the user is not the administrator.
     * @deny (get, list) if the user is not the administrator.
     * @principle Enforces administrator-only access to student attendance data.
     */
    match /students/{studentId}/attendance/{attendanceId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    /**
     * @description Controls access to the /students/{studentId}/payments collection.
     * @path /students/{studentId}/payments/{paymentId}
     * @allow (create, update, delete) if the user is the administrator.
     * @allow (get, list) if the user is the administrator.
     * @deny (create, update, delete) if the user is not the administrator.
     * @deny (get, list) if the user is not the administrator.
     * @principle Enforces administrator-only access to student payment data.
     */
    match /students/{studentId}/payments/{paymentId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}