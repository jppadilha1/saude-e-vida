/**
 * @fileoverview Firestore Security Rules for the Academy App.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for student data
 * and their associated attendance records. Students can only be created,
 * read, updated, or deleted by themselves.
 *
 * Data Structure:
 * The data is organized hierarchically:
 * /students/{studentId} - Contains student profile information.
 * /students/{studentId}/attendance/{attendanceId} - Contains attendance records for a specific student.
 *
 * Key Security Decisions:
 * - Students can only access their own data.
 * - No public listing of students is allowed.
 *
 * Denormalization for Authorization:
 *  - Attendance documents contain a `studentId` field, which is used to
 *    enforce that the attendance record belongs to the correct student.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to student profile documents.
     * @path /students/{studentId}
     * @allow (create) User with matching UID can create their own student document.
     * @allow (get, update, delete) User with matching UID can read, update, or delete their student document.
     * @deny (create) User tries to create a student document with a mismatched UID.
     */
    match /students/{studentId} {
      // Helper function to check if the user is the owner of the student document.
      function isOwner(studentId) {
        return request.auth.uid == studentId;
      }

      // Helper function to check if the user is the existing owner of the student document.
      function isExistingOwner(studentId) {
        return isOwner(studentId) && resource != null;
      }

      // Allow a user to create their own student document if the studentId matches their UID.
      allow create: if isOwner(studentId) && request.resource.data.id == studentId;

      // Allow a user to get their own student document.
      allow get: if isOwner(studentId);

      // Allow a user to list student documents (only their own).
      allow list: if false;

      // Allow a user to update their own student document.
      allow update: if isExistingOwner(studentId) && request.resource.data.id == resource.data.id;

      // Allow a user to delete their own student document.
      allow delete: if isExistingOwner(studentId);
    }

    /**
     * @description Controls access to attendance records for a specific student.
     * @path /students/{studentId}/attendance/{attendanceId}
     * @allow (create) User with matching UID can create attendance records for their own student document.
     * @allow (get, update, delete) User with matching UID can read, update, or delete attendance records for their own student document.
     * @deny (create) User tries to create an attendance record with a mismatched studentId.
     */
    match /students/{studentId}/attendance/{attendanceId} {
       // Helper function to check if the user is the owner of the student document.
      function isOwner(studentId) {
        return request.auth.uid == studentId;
      }

      // Helper function to check if the user is the existing owner of the student document.
      function isExistingOwner(studentId) {
        return isOwner(studentId) && resource != null;
      }

      // Allow a user to create attendance records for their own student document if the studentId matches their UID.
      allow create: if isOwner(studentId) && request.resource.data.studentId == studentId;

      // Allow a user to get attendance records for their own student document.
      allow get: if isOwner(studentId);

      // Allow a user to list attendance records for their own student document.
      allow list: if isOwner(studentId);

      // Allow a user to update attendance records for their own student document.
      allow update: if isExistingOwner(studentId) && request.resource.data.studentId == resource.data.studentId;

      // Allow a user to delete attendance records for their own student document.
      allow delete: if isExistingOwner(studentId);
    }
  }
}