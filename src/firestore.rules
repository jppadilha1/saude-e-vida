rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Rule for the 'users' collection
    // This is opened up for the proof-of-concept manual authentication system.
    // In a production app, this would need to be more secure, likely using
    // server-side logic (like Cloud Functions) to validate admin actions.
    match /users/{userId} {
      // Allows reading the user list (for admins), creating new users (for admins),
      // and deleting users (the admin check is done in client-side code).
      // Update is restricted as a safety measure.
      allow read, create, delete: if true;
      allow update: if false; // Disallow updates from client as a precaution
    }

    // Rules for student-related collections
    // Open for the PoC, as authorization is handled client-side.
    match /students/{studentId} {
       allow read, write: if true;
    }

    match /students/{studentId}/{document=**} {
       allow read, write: if true;
    }
    
    // Rule for workout schedules
    // Open for the PoC.
     match /workoutSchedules/{instructorId} {
      allow read, write: if true;
    }
  }
}
