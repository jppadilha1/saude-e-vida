/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for student data and their attendance records.
 *
 * Data Structure:
 * - /students/{studentId}: Stores student profiles.
 * - /students/{studentId}/attendance/{attendanceId}: Stores individual attendance records for each student.
 *
 * Key Security Decisions:
 * - Students collection is only readable by authenticated users.
 * - Student documents and their attendance subcollections are only accessible by the owner (the student themselves).
 * - No public listing of students or attendance records is allowed.
 * - Data validation is limited to ownership checks and relational integrity (studentId in attendance records).
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to the /students collection. Only authenticated users can read it.
     * @path /students/{studentId}
     * @allow (get, list): Any authenticated user can read all students
     * @deny (create, update, delete): No one can create, update or delete a student without authentication.
     * @principle Authenticated read access to students collection
     */
    match /students/{studentId} {
      allow get, list: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    
      /**
       * @description Controls access to the /students/{studentId}/attendance subcollection. Only the owner (student) can manage their attendance records.
       * @path /students/{studentId}/attendance/{attendanceId}
       * @allow (create): The owner (student) can create attendance records if the studentId matches the path.
       * @allow (get, list, update, delete): The owner (student) can read, list, update, and delete their own attendance records.
       * @deny (create, update, delete): Attempts to create, update, or delete attendance records for other students are denied.
       * @principle Enforces document ownership for attendance records.
       */
      match /attendance/{attendanceId} {
        allow get, list: if isOwner(studentId);
        allow create: if isOwner(studentId) && request.resource.data.studentId == studentId;
        allow update: if isExistingOwner(studentId) && resource.data.studentId == studentId;
        allow delete: if isExistingOwner(studentId);
      }
    }

    /**
     * @description Checks if the request is made by an authenticated user.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user is the owner of the document.
     * @param {string} userId - The user ID to compare against the request's authentication UID.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of an existing document.
     * @param {string} userId - The user ID to compare against the request's authentication UID.
     * @return {boolean} True if the user is the owner and the document exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}