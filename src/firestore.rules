rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is an admin by reading their document in the 'users' collection.
    function isAdmin() {
      // This function now relies on the custom claims (set by a Cloud Function) for security.
      return request.auth.token.isAdmin == true;
    }

    // Helper function to check if the user is authenticated via Firebase Auth.
    function isSignedIn() {
      return request.auth != null;
    }

    // Rule for the 'users' collection
    match /users/{userId} {
      // Any authenticated user can read the user list (e.g., for an admin to see instructors).
      allow read: if isSignedIn();
      
      // Only an admin can create a new user document.
      allow create: if isAdmin();

      // Only an admin can update a user document.
      allow update: if isAdmin();
      
      // An admin can delete a user document only if that user is NOT an admin.
      allow delete: if isAdmin() && resource.data.isAdmin == false;
    }

    // Rule for the students collection
    // An instructor can read/write their own students. An admin has full access.
    match /students/{studentId} {
      allow read, write: if isSignedIn() && (request.auth.uid == resource.data.instructorId || isAdmin());
    }

    // Rule for a student's subcollections (attendance, payments)
    // Allows access if the user is the student's instructor or an admin.
    match /students/{studentId}/{document=**} {
      allow read, write: if isSignedIn() && (get(/databases/$(database)/documents/students/$(studentId)).data.instructorId == request.auth.uid || isAdmin());
    }
    
    // This collection is no longer used, but keeping the rule for safety.
    match /instructors/{instructorId} {
       allow read, write: if false; // Block all access
    }

    // Rule for the workout schedules collection
    // The instructor can read and write only to their own schedule.
    // The administrator also has full access.
    match /workoutSchedules/{instructorId} {
      allow read, write: if isSignedIn() && (request.auth.uid == instructorId || isAdmin());
    }
  }
}
