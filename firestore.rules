rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is an admin by reading their document in the 'users' collection.
    // This function is illustrative, as the isAdmin logic now resides in the app's state.
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Helper function to check if the user is authenticated.
    function isSignedIn() {
      return request.auth != null;
    }

    // Rule for the 'users' collection
    // This is opened up for the proof-of-concept manual authentication system.
    // In a production app, this would need to be more secure.
    match /users/{userId} {
      allow read, write, delete: if true;  // ✅ Adicionado delete
    }

    // Rule for the students collection
    match /students/{studentId} {
      allow read, write, delete: if true;  // ✅ Liberado para POC
    }

    // Rule for a student's subcollections (attendance, payments)
    match /students/{studentId}/{document=**} {
      allow read, write, delete: if true;  // ✅ Liberado para POC
    }
    
    // This collection is no longer used, but keeping the rule for safety.
    // It is replaced by the 'users' collection.
    match /instructors/{instructorId} {
       allow read, write: if false; // Block all access
    }

    // Rule for the workout schedules collection
    match /workoutSchedules/{instructorId} {
      allow read, write, delete: if true;  // ✅ Adicionado delete
    }
  }
}