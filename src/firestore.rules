rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is an admin by reading their document in the 'users' collection.
    // NOTE: With manual authentication, this check is primarily done on the client.
    // This server-side function is illustrative and not reliably used for client-side queries without auth context.
    function isAdmin(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.isAdmin == true;
    }

    // Rule for the 'users' collection
    // This is opened up for the proof-of-concept manual authentication system.
    // In a production app with server-side logic, this would need to be more secure.
    match /users/{userId} {
      allow read, write: if true;
    }

    // Rule for the students collection
    // An instructor can only read or write a student document
    // if the 'instructorId' in the document matches the authenticated instructor's UID.
    // An administrator also has full access.
    // NOTE: This rule will not work as intended with a pure manual auth system from the client,
    // as request.auth is null. It's simplified for the PoC.
    match /students/{studentId} {
       allow read, write: if true;
    }

    // Rule for a student's subcollections (attendance, payments)
    // Allows access to subcollections if the user is the student's instructor or an admin.
    match /students/{studentId}/{document=**} {
       allow read, write: if true;
    }
    
    // This collection is no longer used, but keeping the rule for safety.
    match /instructors/{instructorId} {
       allow read, write: if false; // Block all access
    }

    // Rule for the workout schedules collection
    // The instructor can read and write only to their own schedule.
    // The administrator also has full access.
     match /workoutSchedules/{instructorId} {
      allow read, write: if true;
    }
  }
}
