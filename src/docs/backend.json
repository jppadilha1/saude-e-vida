{
  "entities": {
    "Student": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Student",
      "type": "object",
      "description": "Represents a student in the academy.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Student entity."
        },
        "instructorId": {
          "type": "string",
          "description": "Reference to the Instructor. (Relationship: Instructor 1:N Student)"
        },
        "name": {
          "type": "string",
          "description": "The name of the student."
        },
        "enrollmentDate": {
          "type": "string",
          "description": "The date the student enrolled.",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": [
            "Ativo",
            "Inativo"
          ],
          "description": "The membership status of the student."
        },
        "paymentStatus": {
          "type": "string",
          "enum": [
            "Pago",
            "Pendente"
          ],
          "description": "The payment status of the student."
        },
        "height": {
          "type": "number",
          "description": "The student's height in centimeters."
        },
        "weight": {
          "type": "number",
          "description": "The student's weight in kilograms."
        },
        "bodyMeasurements": {
          "type": "object",
          "description": "The student's body measurements in centimeters.",
          "properties": {
            "chest": {
              "type": "number"
            },
            "waist": {
              "type": "number"
            },
            "hips": {
              "type": "number"
            },
            "leftArm": {
              "type": "number"
            },
            "rightArm": {
              "type": "number"
            },
            "leftThigh": {
              "type": "number"
            },
            "rightThigh": {
              "type": "number"
            }
          }
        },
        "notes": {
          "type": "string",
          "description": "Instructor's notes or observations about the student."
        }
      },
      "required": [
        "id",
        "name",
        "enrollmentDate",
        "status",
        "paymentStatus",
        "instructorId"
      ]
    },
    "Attendance": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Attendance",
      "type": "object",
      "description": "Represents a student's attendance record.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Attendance entity."
        },
        "studentId": {
          "type": "string",
          "description": "Reference to Student. (Relationship: Student 1:N Attendance)"
        },
        "date": {
          "type": "string",
          "description": "The date of the attendance record.",
          "format": "date-time"
        },
        "present": {
          "type": "boolean",
          "description": "Indicates whether the student was present."
        }
      },
      "required": [
        "id",
        "studentId",
        "date",
        "present"
      ]
    },
    "Payment": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Payment",
      "type": "object",
      "description": "Represents a payment made by a student.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Payment entity."
        },
        "studentId": {
          "type": "string",
          "description": "Reference to the Student."
        },
        "paymentDate": {
          "type": "string",
          "description": "The date the payment was made.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "studentId",
        "paymentDate"
      ]
    },
    "Instructor": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Instructor",
      "type": "object",
      "description": "Represents an instructor at the academy.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Instructor entity, matches Firebase Auth UID."
        },
        "name": {
          "type": "string",
          "description": "The name of the instructor."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The email of the instructor, used for login."
        }
      },
      "required": [
        "id",
        "name",
        "email"
      ]
    },
     "Workout": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Workout",
      "description": "Represents the weekly workout schedule for a single instructor.",
      "type": "object",
      "properties": {
        "schedule": {
          "type": "object",
          "description": "The workout schedule, mapping days of the week to time slots and student names.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "required": ["schedule"]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": {
        "$ref": "#/entities/Student"
      },
      "description": "Stores student data. Instructors can only access students linked to their ID."
    },
    "/students/{studentId}/attendance/{attendanceId}": {
      "schema": {
        "$ref": "#/entities/Attendance"
      },
      "description": "Stores attendance records for each student."
    },
    "/students/{studentId}/payments/{paymentId}": {
      "schema": {
        "$ref": "#/entities/Payment"
      },
      "description": "Stores payment history for each student."
    },
    "/instructors/{instructorId}": {
      "schema": {
        "$ref": "#/entities/Instructor"
      },
      "description": "Stores instructor data. Writable only by admins."
    },
    "/workouts/{instructorId}": {
      "schema": { "$ref": "#/entities/Workout" },
      "description": "Stores the weekly workout schedule for each instructor. The document ID is the instructor's UID."
    }
  }
}
