rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is an admin by reading their document in the 'users' collection.
    // This function is illustrative, as the isAdmin logic now resides in the app's state.
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Helper function to check if the user is authenticated.
    function isSignedIn() {
      return request.auth != null;
    }

    // Rule for the 'users' collection
    // This is opened up for the proof-of-concept manual authentication system.
    // In a production app, this would need to be more secure.
    match /users/{userId} {
      allow read, write: if true;
    }

    // Rule for the students collection
    // An instructor can only read or write a student document
    // if the 'instructorId' in the document matches the authenticated instructor's UID.
    // An administrator also has full access.
    // NOTE: This rule will only work once the manual auth state is established in the app.
    match /students/{studentId} {
      allow read, write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.instructorId == resource.data.instructorId || isAdmin();
    }

    // Rule for a student's subcollections (attendance, payments)
    // Allows access to subcollections if the user is the student's instructor or an admin.
    match /students/{studentId}/{document=**} {
      allow read, write: if get(/databases/$(database)/documents/students/$(studentId)).data.instructorId == request.auth.uid || isAdmin();
    }
    
    // This collection is no longer used, but keeping the rule for safety.
    // It is replaced by the 'users' collection.
    match /instructors/{instructorId} {
       allow read, write: if false; // Block all access
    }

    // Rule for the workout schedules collection
    // The instructor can read and write only to their own schedule.
    // The administrator also has full access.
    match /workoutSchedules/{instructorId} {
      allow read, write: if request.auth.uid == instructorId || isAdmin();
    }
  }
}
