rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /students/{studentId} {
      // Um instrutor só pode acessar um aluno se for o instrutor atribuído.
      // Um administrador pode acessar qualquer aluno.
      allow read, write: if request.auth.uid == resource.data.instructorId || isAdmin();
    }

    match /students/{studentId}/{document=**} {
      // Permite o acesso a subcoleções (presença, pagamentos) se o usuário estiver autenticado
      // e tiver acesso ao documento pai do aluno.
      allow read, write: if isSignedIn() && (get(/databases/$(database)/documents/students/$(studentId)).data.instructorId == request.auth.uid || isAdmin());
    }
    
    match /instructors/{instructorId} {
      // Qualquer usuário autenticado pode ver a lista de instrutores.
      allow get, list: if isSignedIn();
      // Apenas um administrador pode criar, atualizar ou excluir um instrutor.
      allow create, update, delete: if isAdmin();
    }

    match /workoutSchedules/{instructorId} {
      // Um usuário autenticado pode criar sua própria agenda.
      allow create: if isSignedIn();
      // Um instrutor só pode ler, atualizar ou deletar sua própria agenda. Admins também têm acesso.
      allow read, update, delete: if request.auth.uid == instructorId || isAdmin();
    }
  }

  function isSignedIn() {
    return request.auth != null;
  }

  function isAdmin() {
    // Define "Admin" como o usuário com este e-mail específico (case-insensitive).
    return request.auth.token.email.lower() == "adm@gmail.com";
  }
}
