/**
 * @file Firestore Security Rules
 * @core_philosophy This ruleset enforces a strict user-ownership model for student data,
 * ensuring that only the authenticated user who owns a student document or is accessing
 * public information can read and write to it. Data consistency is enforced where appropriate.
 * All write operations require authentication.
 * @data_structure The data is structured hierarchically under /students/{studentId}, with
 * attendance and payment subcollections for each student.
 * @key_security_decisions
 *   - Students can only be created by themselves (self-creation).
 *   - Students can only read/write their own data.
 *   - Listing all students is disallowed.
 * @denormalization_for_authorization N/A - The rules rely on the path structure to enforce ownership, not denormalized data.
 * @structural_segregation N/A - No explicit segregation of public vs. private data is defined.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to the /students collection. Only the student themselves can read and write their data.
     * @path /students/{studentId}
     * @allow (create) - Authenticated user with UID matching the studentId can create the document.
     * @allow (get, update, delete) - Authenticated user with UID matching the studentId can read, update, and delete the document.
     * @deny (create) - Authenticated user with UID not matching the studentId cannot create the document.
     * @deny (get, update, delete) - Authenticated user with UID not matching the studentId cannot read, update, and delete the document.
     * @deny (list) - Listing students is not allowed.
     * @principle Enforces document ownership for all operations.
     */
    match /students/{studentId} {
      //Utility function to check user authentication
      function isSignedIn() {
        return request.auth != null;
      }

      //Utility function to check ownership
      function isOwner(studentId) {
        return request.auth.uid == studentId;
      }

      //Utility function to check existing ownership for destructive operations
      function isExistingOwner(studentId) {
          return (isOwner(studentId) && resource != null);
      }

      allow get: if isOwner(studentId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(studentId);
      allow update: if isExistingOwner(studentId);
      allow delete: if isExistingOwner(studentId);
    }

    /**
     * @description Controls access to the /students/{studentId}/attendance collection. Only the student themselves can read and write their attendance data.
     * @path /students/{studentId}/attendance/{attendanceId}
     * @allow (create) - Authenticated user with UID matching the studentId can create attendance record.
     * @allow (get, update, delete) - Authenticated user with UID matching the studentId can read, update, and delete attendance record.
     * @deny (create) - Authenticated user with UID not matching the studentId cannot create the attendance record.
     * @deny (get, update, delete) - Authenticated user with UID not matching the studentId cannot read, update, and delete the attendance record.
     * @principle Enforces document ownership for all operations.
     */
    match /students/{studentId}/attendance/{attendanceId} {

      //Utility function to check user authentication
      function isSignedIn() {
        return request.auth != null;
      }

      //Utility function to check ownership
      function isOwner(studentId) {
        return request.auth.uid == studentId;
      }

      //Utility function to check existing ownership for destructive operations
      function isExistingOwner(studentId) {
          return (isOwner(studentId) && resource != null);
      }

      allow get: if isOwner(studentId);
      allow list: if isOwner(studentId);
      allow create: if isSignedIn() && isOwner(studentId) && request.resource.data.studentId == studentId;
      allow update: if isExistingOwner(studentId);
      allow delete: if isExistingOwner(studentId);
    }

    /**
     * @description Controls access to the /students/{studentId}/payments collection. Only the student themselves can read and write their payment data.
     * @path /students/{studentId}/payments/{paymentId}
     * @allow (create) - Authenticated user with UID matching the studentId can create payment record.
     * @allow (get, update, delete) - Authenticated user with UID matching the studentId can read, update, and delete payment record.
     * @deny (create) - Authenticated user with UID not matching the studentId cannot create the payment record.
     * @deny (get, update, delete) - Authenticated user with UID not matching the studentId cannot read, update, and delete the payment record.
     * @principle Enforces document ownership for all operations.
     */
    match /students/{studentId}/payments/{paymentId} {

      //Utility function to check user authentication
      function isSignedIn() {
        return request.auth != null;
      }

      //Utility function to check ownership
      function isOwner(studentId) {
        return request.auth.uid == studentId;
      }

      //Utility function to check existing ownership for destructive operations
      function isExistingOwner(studentId) {
          return (isOwner(studentId) && resource != null);
      }

      allow get: if isOwner(studentId);
      allow list: if isOwner(studentId);
      allow create: if isSignedIn() && isOwner(studentId) && request.resource.data.studentId == studentId;
      allow update: if isExistingOwner(studentId);
      allow delete: if isExistingOwner(studentId);
    }
  }
}